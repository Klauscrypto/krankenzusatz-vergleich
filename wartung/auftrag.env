# Wartungsauftrag für den Server – wird nach jedem erfolgreichen Deploy ausgeführt,
# aber nur, wenn sich DIESE Datei im Commit geändert hat (.github/workflows/wartung.yml).
# Leere Werte = nichts tun.

# Artikel-Generator täglich statt Mo–Fr (1 = Crontab-Zeile auf jeden Tag stellen)
CRON_TAEGLICH=1

# Bestehende Beiträge mit neuem Verfahren (Faktencheck + Qualitätsprüfung) neu schreiben, URL bleibt.
# 144 = Gleitsichtbrille (KI-Selbstkorrektur im Text), 145 = Parodontose (Text abgeschnitten)
REPAIR_IDS=144,145
